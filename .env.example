# ============================================================================
# acc.asis (ACAS) — Environment Configuration (100% Free-Tier Ready)
# ============================================================================

# 1. Telegram Bot & Mini App Configuration
TELEGRAM_BOT_TOKEN=your_botfather_token_here
MINI_APP_URL=https://acc-asis.vercel.app

# 2. Official Telegram MTProto API (https://my.telegram.org -> API development tools)
# Required for real user account connection + mandatory 2FA verification via GramJS
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_telegram_api_hash_here
SESSION_ENCRYPTION_SECRET=change_this_to_a_32_char_secret_key

# 3. Database Provider Selection (All Free Tier Compatible)
# Options: "memory" (instant zero-config) | "firebase" | "supabase" | "neon"
DB_PROVIDER=memory

# --- Option A: Firebase Firestore (Free Spark Plan) ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Option B: Supabase PostgreSQL (Free Tier) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Option C: Neon Serverless Postgres (Free Tier) ---
NEON_DATABASE_URL=

# 4. Server Port
PORT=4000
